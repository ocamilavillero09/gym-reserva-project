# ── Imagen de PRODUCCIÓN del frontend (la que despliega Jenkins/ArgoCD) ──
# Etapa 1: compila el bundle estático de React/Vite.
# Node 20: vite-plugin-pwa (workbox) requiere Node >= 20 para el build.
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
# En producción el frontend habla con el backend por la ruta relativa /api,
# que nginx redirige al Service "backend" dentro del cluster.
ENV VITE_API_URL=/api
RUN npm run build

# Etapa 2: nginx sirve los estáticos y hace de proxy a la API.
FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
